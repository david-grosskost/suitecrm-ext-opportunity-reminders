{
    "name": "david-grosskost/suitecrm-ext-opportunity-reminders",
    "description": "Relances des opportunités SuiteCRM : une tâche pour le commercial quand une opportunité ouverte n'a pas bougé depuis un nombre de jours réglable.",
    "type": "suitecrm-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.21"
    },
    "autoload-dev": {
        "classmap": ["legacy/include/"],
        "psr-4": {
            "SuiteCrmExt\\Exemple\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    }
}
